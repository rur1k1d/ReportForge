<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ report.title }}</title>
<style>
  :root { --accent: {{ branding.accent_color or "#B22222" }}; --line:#ddd; --ink:#222; --muted:#666; }
  body { font-family: "Segoe UI", Helvetica, Arial, sans-serif; color: var(--ink); margin:0; line-height:1.55; font-size:14px; }
  .page { max-width: 860px; margin: 0 auto; padding: 48px 56px; }
  .cover { border-bottom: 4px solid var(--accent); padding-bottom: 20px; margin-bottom: 28px; }
  .cover .company { color: var(--accent); letter-spacing:.12em; text-transform:uppercase; font-weight:700; font-size:12px; }
  .cover h1 { font-size: 26px; margin: 6px 0 2px; }
  .cover .meta { color: var(--muted); font-size:13px; }
  h2 { border-bottom: 2px solid var(--accent); padding-bottom:4px; font-size:18px; margin-top:30px; }
  table.stats { border-collapse: collapse; margin:14px 0; }
  table.stats th, table.stats td { border:1px solid var(--line); padding:6px 12px; }
  table.stats th { background:#f5f5f5; }
  @media print { body { font-size:12px;} .page { padding:12mm;} }
  @page { size: A4; margin: 16mm 14mm; }
</style>
</head>
<body>
<div class="page">
  <div class="cover">
    <div class="company">{{ branding.company }}</div>
    <h1>{{ report.title }}</h1>
    <div class="meta">Client: <b>{{ report.client }}</b> &middot; {{ report.version }}</div>
  </div>

  <h2>1. Executive Summary</h2>
  <p>{{ summary }}</p>

  <h2>2. Scan Scope</h2>
  <p>{{ report.scope or "—" }}</p>

  <h2>3. Results</h2>
  <table class="stats">
    <thead><tr><th>Severity</th><th>Count</th></tr></thead>
    <tbody>
      {% for row in severity_rows %}<tr><td>{{ row.label }}</td><td>{{ row.count }}</td></tr>{% endfor %}
    </tbody>
  </table>

  <h2>4. Details</h2>
  {% if findings %}
    {% for f in findings %}
    <h3>{{ f.title }}</h3>
    <p><b>Severity:</b> {{ f.severity.upper() }}{% if f.asset %} &middot; <b>Asset:</b> {{ f.asset }}{% endif %}</p>
    {% if f.description %}<p>{{ f.description }}</p>{% endif %}
    {% if f.recommendation %}<p><b>Fix:</b> {{ f.recommendation }}</p>{% endif %}
    {% endfor %}
  {% else %}
    <p><i>No findings.</i></p>
  {% endif %}

  <p style="margin-top:30px; color:var(--muted); font-size:11px;">Generated by ReportForge</p>
</div>
</body>
</html>